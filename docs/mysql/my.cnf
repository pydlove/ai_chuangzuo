# 爱创作 MySQL 8.0 生产配置
# 目标系统: CentOS Stream 9（RHEL 9 系）
# 安装方式: dnf module install mysql:8.0
# 用法: 上传到服务器后替换 /etc/my.cnf，或放到 /etc/my.cnf.d/ 下命名 aichuangzuo.cnf
# 注意:
#   1. 修改 innodb_buffer_pool_size 前先用 free -h 看内存，建议设为物理内存的 50%~70%
#   2. 云服务器（腾讯云/阿里云）需在控制台安全组放行对应端口
#   3. 修改后执行: systemctl restart mysqld

[mysqld]
# ---------- 网络 ----------
bind-address = 0.0.0.0
port = 28080

# ---------- 字符集 ----------
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
init_connect = 'SET NAMES utf8mb4'

# ---------- 时区（需与后端连接串 serverTimezone=Asia/Shanghai 一致）----------
default-time-zone = '+08:00'

# ---------- InnoDB ----------
# 缓冲池，按服务器内存调整（小机器 512M，4G 内存机器可给 2G）
innodb_buffer_pool_size = 512M
innodb_log_file_size = 256M
innodb_flush_log_at_trx_commit = 1
innodb_file_per_table = 1
innodb_default_row_format = DYNAMIC

# ---------- 连接 ----------
max_connections = 500
wait_timeout = 28800
interactive_timeout = 28800
max_allowed_packet = 64M

# ---------- SQL 模式 ----------
# 去掉了 ONLY_FULL_GROUP_BY，兼容常见查询写法
sql_mode = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# ---------- 日志 ----------
# 错误日志
log_error = /var/log/mysql/mysqld.log

# 慢查询日志（排障必备）
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2

# binlog（数据恢复 / 主从复制用）
log_bin = mysql-bin
binlog_format = ROW
binlog_expire_logs_seconds = 604800
max_binlog_size = 512M

[mysql]
default-character-set = utf8mb4

[client]
default-character-set = utf8mb4
port = 28080
