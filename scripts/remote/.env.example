# 爱创作生产环境环境变量
# 此文件会在服务器部署时上传到 /root/app/aichuangzuo/.env
# 并被 systemd service 加载

# 说明：
# - 数据库连接已分别写入 application-dev.yml（开发）和 application-prod.yml（生产）
# - 生产数据库账号密码使用 ENC(...) 加密，启动时需要 JASYPT_ENCRYPTOR_PASSWORD 解密
# - 如需覆盖 dev 默认数据库账号密码，可设置 MYSQL_USERNAME / MYSQL_PASSWORD

# Jasypt 加密密钥（必须，用于解密 application-prod.yml 中的 ENC(...) 值）
JASYPT_ENCRYPTOR_PASSWORD=your-jasypt-password-here

# 可选：开发环境覆盖默认数据库账号密码
# MYSQL_USERNAME=root
# MYSQL_PASSWORD=your-local-db-password

# 可选：覆盖默认数据源 URL
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/aichuangzuo?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai

# 邮件服务配置（支持明文或 ENC(...) 加密值）
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_USERNAME=noreply@example.com
# SPRING_MAIL_PASSWORD=your-mail-password

# JWT 密钥（生产环境必须修改）
# ADMIN_JWT_ACCESS_SECRET=your-admin-jwt-access-secret
# ADMIN_JWT_REFRESH_SECRET=your-admin-jwt-refresh-secret
# JWT_ACCESS_SECRET=your-user-jwt-access-secret
# JWT_REFRESH_SECRET=your-user-jwt-refresh-secret

# 内部 API 调用密钥
# USER_API_INTERNAL_KEY=your-internal-key
# INTERNAL_API_KEY=your-internal-key
